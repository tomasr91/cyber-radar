  "topics": [
   {
    "id": "vulnerabilities_cve",
    "name": "Nieuwe kwetsbaarheden (CVE's)",
    "description": "Nieuwe kwetsbaarheden en softwarefouten in software die organisaties gebruiken: Windows, Linux, PHP, webservers, browsers, databases, API's en cloudplatformen. Niet alleen het CVE-nummer en de score: wat gaat er technisch fout, wie loopt risico en hoe los je het op.",
    "priority": 5,
    "area": "kwetsbaarheden"
   },
   {
    "id": "exploited_vulnerabilities",
    "name": "Actief misbruikte kwetsbaarheden en zero-days",
    "description": "Kwetsbaarheden die aanvallers nu al misbruiken, zero-days en toevoegingen aan de CISA-lijst van misbruikte kwetsbaarheden (KEV). Juist hier wordt duidelijk waarom iets urgent is.",
    "priority": 5,
    "area": "kwetsbaarheden"
   },
   {
    "id": "edge_devices",
    "name": "VPN's, firewalls en andere randapparatuur",
    "description": "Kwetsbaarheden in apparaten aan de rand van het netwerk (VPN-servers, firewalls, load balancers, bestandsoverdracht). Vaak bereikbaar vanaf internet en daardoor een favoriete ingang voor aanvallers.",
    "priority": 4,
    "area": "kwetsbaarheden"
   },
   {
    "id": "attack_techniques",
    "name": "Aanvalstechnieken uitgelegd",
    "description": "Hoe een aanval technisch verloopt: remote code execution, SQL injection, cross-site scripting, privilege escalation, credential theft, authentication bypass, laterale beweging, command and control en misbruik van bestaande rechten. Centraal leergebied.",
    "priority": 5,
    "area": "techniek",
    "learning": true
   },
   {
    "id": "web_software_security",
    "name": "Webtechnologie en softwarebeveiliging",
    "description": "Hoe websites, webservers, API's, databases, sessies en authenticatie werken, en waar het misgaat. PHP, JavaScript, HTTP, Apache, Nginx, OAuth, cookies en open-sourcecomponenten. Eerst de normale werking, dan de fout.",
    "priority": 4,
    "area": "techniek",
    "learning": true
   },
   {
    "id": "phishing_identity",
    "name": "Phishing, identiteit en accounts",
    "description": "Phishing, social engineering en aanvallen op accounts: wachtwoorden stelen, MFA omzeilen, sessietokens kapen, misbruik van Microsoft 365 en Entra ID.",
    "priority": 4,
    "area": "techniek"
   },
   {
    "id": "malware",
    "name": "Malware",
    "description": "Hoe malware werkt: infostealers, loaders, backdoors, remote access trojans en botnets. Hoe het binnenkomt, wat het doet en hoe je het ziet.",
    "priority": 4,
    "area": "techniek"
   },
   {
    "id": "supply_chain",
    "name": "Aanvallen via leveranciers en software",
    "description": "Aanvallen via de toeleveringsketen: besmette open-sourcepakketten (npm, PyPI), gekaapte updates en aanvallen via een leverancier of IT-dienstverlener.",
    "priority": 4,
    "area": "techniek"
   },
   {
    "id": "incidents_breaches",
    "name": "Hacks, datalekken en incidenten",
    "description": "Cyberaanvallen op organisaties, datalekken en incidenten waarbij systemen uit moeten. Alleen interessant met technische inhoud: hoe kwam de aanvaller binnen, wat is bevestigd en wat nog niet.",
    "priority": 5,
    "area": "incidenten"
   },
   {
    "id": "ransomware",
    "name": "Ransomware",
    "description": "Ransomware-aanvallen en -groepen: hoe ze binnenkomen, zich verspreiden, data stelen en versleutelen, en hoe organisaties zich herstellen.",
    "priority": 5,
    "area": "incidenten"
   },
   {
    "id": "cloud_attacks",
    "name": "Aanvallen op cloudomgevingen",
    "description": "Aanvallen op en fouten in cloudomgevingen: Azure, AWS, Google Cloud, Microsoft 365, verkeerde instellingen, gelekte sleutels en misbruik van cloudidentiteiten.",
    "priority": 4,
    "area": "incidenten"
   },
   {
    "id": "siem_detection",
    "name": "SIEM, logs en detectie",
    "description": "Hoe aanvallen zichtbaar worden: logs, detectieregels, alerts, EDR, netwerkmonitoring en threat hunting. Hoe een securityanalist een melding onderzoekt en hoe false positives ontstaan. Centraal leergebied.",
    "priority": 5,
    "area": "praktijk",
    "learning": true
   },
   {
    "id": "vulnerability_management",
    "name": "Vulnerability management en prioriteren",
    "description": "Kwetsbaarheden vinden, systemen inventariseren, risico's beoordelen en prioriteren, patchen en controleren. CVSS, EPSS en KEV, en waarom een hoge score niet altijd het meest urgent is.",
    "priority": 5,
    "area": "praktijk",
    "learning": true
   },
   {
    "id": "threat_intelligence",
    "name": "Threat intelligence en aanvallersgroepen",
    "description": "Aanvallersgroepen, campagnes, nieuwe technieken en patronen. Vooral: wat betekent deze informatie en hoe gebruikt een organisatie het (bij detectie en prioriteren).",
    "priority": 5,
    "area": "praktijk"
   },
   {
    "id": "incident_response",
    "name": "Incident response en onderzoek",
    "description": "Hoe een organisatie een incident onderzoekt en afhandelt: forensisch onderzoek, indammen, herstellen en lessen trekken. Inclusief volledige aanvalsketens uit echte onderzoeken.",
    "priority": 4,
    "area": "praktijk"
   },
   {
    "id": "security_market",
    "name": "Securitymarkt en leveranciers",
    "description": "Groot nieuws over securityleveranciers (zoals Tenable, Qualys, CrowdStrike, Splunk, SentinelOne, Microsoft): grote overnames, koerswijzigingen of productlijnen die stoppen. Alleen bij groot nieuws.",
    "priority": 1,
    "area": "overig"
   },
   {
